# ==============================================================================
# GeoGuide Environment Configuration Template (.env.example)
#
# Copy this file to .env.local (for local development) or configure in Vercel:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Maps Platform (Optional)
# ------------------------------------------------------------------------------
# Required for:
#   - Google Street View 360° interactive embeds (modal and compare views)
#   - Optional Google Maps roadmap basemap layer switcher
# Note:
#   - If left blank, the site operates 100% fine on OpenStreetMap (CartoDB),
#     and Street View frames will show a prompt to configure an API key.
# Get a key at: https://console.cloud.google.com/
# Required APIs to enable: Maps Embed API + Maps JavaScript API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 2. Database (Turso / LibSQL)
# ------------------------------------------------------------------------------
# Required for:
#   - Storing submissions, review states, user reactions, favorites, and tags
# Get a free database at: https://turso.tech/
TURSO_URL=libsql://your-database-name.turso.io
TURSO_TOKEN=your_turso_auth_token_here

# Backward-compatible variable aliases (optional):
# turso_database_url=libsql://your-database-name.turso.io
# turso_auth_token=your_turso_auth_token_here

# ------------------------------------------------------------------------------
# 3. Admin & Moderation Credentials
# ------------------------------------------------------------------------------
# Password for the review dashboard (/review.html)
admin_password=your_secure_admin_password_here

# Super admin Discord ID for elevated moderation operations (e.g., country locking)
super_admin_discord_id=your_discord_user_id_here

# ------------------------------------------------------------------------------
# 4. Discord OAuth2 Authentication (Optional)
# ------------------------------------------------------------------------------
# Required for:
#   - User login, personalized favorites, submission history, and reputation
# Configure an OAuth2 application at: https://discord.com/developers/applications
discord_client_id=your_discord_client_id_here
discord_client_secret=your_discord_client_secret_here
# For local dev: http://localhost:3000/api/auth?action=callback
# For production: https://your-domain.com/api/auth?action=callback
discord_redirect_uri=http://localhost:3000/api/auth?action=callback

# ------------------------------------------------------------------------------
# 5. AI Notes Translation (Optional)
# ------------------------------------------------------------------------------
# Required for:
#   - One-click machine translation of submission notes in the explore modal
# Get a key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
