{
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/explore",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|Twitterbot|facebookexternalhit|TelegramBot|Slackbot|WhatsApp|discordbot|twitterbot|telegrambot|slackbot|whatsapp).*"
        }
      ],
      "destination": "/api/submissions?action=og",
      "permanent": false
    },
    {
      "source": "/explore.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|Twitterbot|facebookexternalhit|TelegramBot|Slackbot|WhatsApp|discordbot|twitterbot|telegrambot|slackbot|whatsapp).*"
        }
      ],
      "destination": "/api/submissions?action=og",
      "permanent": false
    }
  ],
  "functions": {
    "api/submissions.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/images/og/:path*",
      "destination": "/api/submissions?action=image&region=:path"
    },
    {
      "source": "/explore",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|Twitterbot|facebookexternalhit|TelegramBot|Slackbot|WhatsApp|discordbot|twitterbot|telegrambot|slackbot|whatsapp).*"
        }
      ],
      "destination": "/api/submissions?action=og"
    },
    {
      "source": "/explore.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Discordbot|Twitterbot|facebookexternalhit|TelegramBot|Slackbot|WhatsApp|discordbot|twitterbot|telegrambot|slackbot|whatsapp).*"
        }
      ],
      "destination": "/api/submissions?action=og"
    },
    {
      "source": "/share",
      "destination": "/api/submissions?action=og"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.tile.openstreetmap.org https://flagcdn.com https://upload.wikimedia.org https://*.googleusercontent.com https://*.ggpht.com https://*.googleapis.com https://*.gstatic.com https://cdn.discordapp.com https://unpkg.com; frame-src 'self' https://www.google.com; connect-src 'self' https://api.discord.com https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://maps.googleapis.com https://maps.gstatic.com; object-src 'none'; base-uri 'self'; form-action 'self';" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
